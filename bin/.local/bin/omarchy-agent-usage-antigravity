#!/usr/bin/python3
# omarchy:summary=Print the Antigravity usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Google Antigravity usage into one display-ready JSON record.

Antigravity keeps its conversations as protobuf blobs, so this collector only
reads metadata: the CLI's history.jsonl (timestamps, conversation ids and
whether an entry was a slash command — never the prompt text) and the
conversation_summaries.db that both the IDE and the CLI maintain (ids, step
counts and timestamps). Antigravity stores no readable token counts, so the
record counts prompts per day instead of tokens.

Limits come from `agy -p /usage`, which prints one tab-separated line per
quota pool and window (Gemini models / Claude and GPT models, five-hour and
weekly) without starting a conversation. agy takes several seconds to start,
so the last good answer is cached and reused for a short while. The agents
panel only ever reads what this prints.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import socket
import sqlite3
import subprocess
import sys
import time
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from typing import Any

AGENT_ID = "antigravity"
AGENT_NAME = "Antigravity"

GEMINI_HOME = Path(os.environ.get("GEMINI_HOME") or Path.home() / ".gemini")
APP_DIRS = [GEMINI_HOME / "antigravity-cli", GEMINI_HOME / "antigravity"]

CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "omarchy" / "agents"
LIMITS_CACHE = CACHE_DIR / "antigravity-limits.json"
# Opening the panel asks for limits every time; agy's cold start is not worth
# paying more than once a minute or so.
LIMITS_FRESH_SECONDS = 90
USAGE_TIMEOUT_SECONDS = 45

FIVE_HOURS = 5 * 3600
ONE_WEEK = 7 * 24 * 3600


def local_date(ms: float) -> str | None:
  try:
    return datetime.fromtimestamp(ms / 1000).date().isoformat()
  except (OverflowError, OSError, ValueError):
    return None


def parse_db_time(value: Any) -> str | None:
  """Go writes `2026-10-10 12:03:12.726778541+00:00`; zero time means unset."""
  text = str(value or "").strip()
  if not text or text.startswith("0001-"):
    return None
  head, _, rest = text.partition(".")
  offset = ""
  for sign in ("+", "-"):
    if sign in rest:
      offset = sign + rest.split(sign, 1)[1]
      break
  try:
    parsed = datetime.fromisoformat(head + offset)
  except ValueError:
    return None
  if parsed.tzinfo is None:
    parsed = parsed.replace(tzinfo=timezone.utc)
  return parsed.astimezone().date().isoformat()


def read_history(path: Path) -> list[dict[str, Any]]:
  entries = []
  try:
    with path.open(encoding="utf-8") as handle:
      for line in handle:
        try:
          raw = json.loads(line)
        except ValueError:
          continue
        if not isinstance(raw, dict):
          continue
        day = local_date(float(raw.get("timestamp") or 0))
        if not day:
          continue
        entries.append({
          "date": day,
          "conversationId": str(raw.get("conversationId") or ""),
          "prompt": raw.get("type") != "slash_command",
        })
  except OSError:
    pass
  return entries


def read_summaries(path: Path) -> list[dict[str, Any]]:
  if not path.is_file():
    return []
  try:
    db = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=2)
    try:
      rows = db.execute(
        "select conversation_id, step_count, last_user_input_time, last_modified_time "
        "from conversation_summaries where nesting_depth = 0"
      ).fetchall()
    finally:
      db.close()
  except sqlite3.Error:
    return []
  return [
    {
      "conversationId": str(row[0] or ""),
      "steps": int(row[1] or 0),
      "date": parse_db_time(row[2]) or parse_db_time(row[3]),
    }
    for row in rows
  ]


def pool_name(raw: str) -> str:
  text = raw.strip()
  if text.lower().startswith("gemini"):
    return "Gemini"
  if "claude" in text.lower() or "gpt" in text.lower():
    return "Claude & GPT"
  return re.sub(r"\s+models?$", "", text, flags=re.I) or "Models"


def parse_usage(output: str) -> list[dict[str, Any]]:
  """`Gemini Models<TAB>Weekly Limit Remaining<TAB>98%<TAB>2026-10-14T15:12:18Z`"""
  limits = []
  for line in output.splitlines():
    cols = [col.strip() for col in line.split("\t")]
    if len(cols) < 3:
      continue
    match = re.match(r"^(\d+(?:\.\d+)?)\s*%$", cols[2])
    if not match:
      continue
    window = cols[1].lower()
    if "week" in window:
      seconds, kind = ONE_WEEK, "weekly"
    elif "five" in window or "5" in window or "hour" in window:
      seconds, kind = FIVE_HOURS, "session"
    else:
      seconds, kind = 0, cols[1]
    remaining = max(0.0, min(100.0, float(match.group(1)))) / 100
    pool = pool_name(cols[0])
    limits.append({
      "label": f"{pool} {kind}",
      "title": f"{pool} · {'5-hour' if seconds == FIVE_HOURS else 'weekly' if seconds == ONE_WEEK else kind}",
      "percent": round(1 - remaining, 4),
      "resetsAt": cols[3] if len(cols) > 3 else "",
      "windowSeconds": seconds,
      "pool": pool,
    })
  # Pool by pool, short window first: the order the panel lists them in.
  limits.sort(key=lambda item: (item["pool"] != "Gemini", item["pool"], item["windowSeconds"]))
  return limits


def read_limits_cache() -> dict[str, Any] | None:
  try:
    cached = json.loads(LIMITS_CACHE.read_text(encoding="utf-8"))
  except (OSError, ValueError):
    return None
  return cached if isinstance(cached, dict) and isinstance(cached.get("limits"), list) else None


def write_limits_cache(limits: list[dict[str, Any]]) -> None:
  try:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = LIMITS_CACHE.with_suffix(".tmp")
    tmp.write_text(json.dumps({"fetchedAt": time.time(), "limits": limits}), encoding="utf-8")
    tmp.replace(LIMITS_CACHE)
  except OSError:
    pass


def still_current(limits: list[dict[str, Any]]) -> list[dict[str, Any]]:
  """A cached window whose reset has passed is no longer true; drop it."""
  now = datetime.now(timezone.utc)
  kept = []
  for limit in limits:
    try:
      reset = datetime.fromisoformat(str(limit.get("resetsAt") or "").replace("Z", "+00:00"))
    except ValueError:
      reset = None
    if reset is None or reset > now:
      kept.append(limit)
  return kept


def online() -> bool:
  """Offline, agy cannot refresh its token and opens a Google sign-in page."""
  try:
    socket.create_connection(("oauth2.googleapis.com", 443), timeout=3).close()
    return True
  except OSError:
    return False


def fetch_limits(force: bool) -> tuple[list[dict[str, Any]], bool]:
  """Returns (limits, reached). `reached` is False when agy could not answer."""
  cached = read_limits_cache()
  if cached and not force and time.time() - float(cached.get("fetchedAt") or 0) < LIMITS_FRESH_SECONDS:
    return still_current(cached["limits"]), True

  agy = shutil.which("agy")
  if agy and online():
    try:
      result = subprocess.run(
        [agy, "-p", "/usage", "--print-timeout", f"{USAGE_TIMEOUT_SECONDS - 5}s"],
        capture_output=True, text=True, timeout=USAGE_TIMEOUT_SECONDS,
        stdin=subprocess.DEVNULL, cwd=str(Path.home()),
      )
      limits = parse_usage(result.stdout) if result.returncode == 0 else []
    except (OSError, subprocess.SubprocessError):
      limits = []
    if limits:
      write_limits_cache(limits)
      return limits, True

  # agy missing, signed out or offline: keep showing the last answer while
  # its windows are still open.
  return still_current(cached["limits"]) if cached else [], False


def current_model() -> str:
  for app_dir in APP_DIRS:
    try:
      settings = json.loads((app_dir / "settings.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
      continue
    model = str(settings.get("model") or "").strip() if isinstance(settings, dict) else ""
    if model:
      return model
  return ""


def build_record(force: bool) -> dict[str, Any]:
  limits, reached = fetch_limits(force)
  today = date.today()
  recent = [(today - timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]

  prompts_by_day: dict[str, int] = {}
  sessions_by_day: dict[str, set[str]] = {}
  conversations: set[str] = set()
  total_prompts = 0
  total_steps = 0
  found = False

  for app_dir in APP_DIRS:
    if not app_dir.is_dir():
      continue
    found = True

    for entry in read_history(app_dir / "history.jsonl"):
      if entry["conversationId"]:
        sessions_by_day.setdefault(entry["date"], set()).add(entry["conversationId"])
        conversations.add(entry["conversationId"])
      if entry["prompt"]:
        prompts_by_day[entry["date"]] = prompts_by_day.get(entry["date"], 0) + 1
        total_prompts += 1

    # The IDE writes no history.jsonl, so its conversations only reach the
    # session counts through their summaries.
    for summary in read_summaries(app_dir / "conversation_summaries.db"):
      total_steps += summary["steps"]
      if summary["conversationId"]:
        conversations.add(summary["conversationId"])
        if summary["date"]:
          sessions_by_day.setdefault(summary["date"], set()).add(summary["conversationId"])

  active_dates = sorted(set(prompts_by_day) | set(sessions_by_day))
  today_key = today.isoformat()

  return {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": found,
    "hasLocalStats": found,
    "hasPromptStats": True,
    # Antigravity stores no token counts we can read, so the daily chart
    # counts prompts and the panel labels it that way.
    "dayUnit": "prompts",
    "tierLabel": current_model() or "Google",
    "usageStatusText": "" if found else "Antigravity not found",
    "authHelpText": "" if found else "Install Antigravity or run `agy` once to start collecting usage.",
    "limits": limits,
    # The panel retries sooner when the endpoint was out of reach (the
    # seconds after login before the network is up).
    "retryAdvised": found and not reached,
    "todayPrompts": prompts_by_day.get(today_key, 0),
    "todaySessions": len(sessions_by_day.get(today_key, ())),
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": day, "messageCount": prompts_by_day.get(day, 0)} for day in recent],
    "totalPrompts": total_prompts,
    "totalSessions": len(conversations),
    "totalSteps": total_steps,
    "activeDays": len(active_dates),
    "activeDates": active_dates,
    "modelUsage": {},
  }


def main() -> int:
  parser = argparse.ArgumentParser(description=__doc__)
  # --force skips the limits cache. Local stats are a cheap read either way,
  # so --limits-only changes nothing; it exists so every collector accepts
  # the same arguments.
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()
  json.dump(build_record(args.force), sys.stdout, separators=(",", ":"))
  sys.stdout.write("\n")
  return 0


if __name__ == "__main__":
  sys.exit(main())
